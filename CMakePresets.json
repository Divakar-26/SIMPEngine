{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with compile commands; physics tuned for this CPU",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SIMP_NATIVE_CPU": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized, portable build: use it for packages and shipped games",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gles",
      "displayName": "OpenGL ES 3 (desktop test)",
      "description": "Debug build that renders through OpenGL ES 3, the path Android uses; runs on desktop drivers that expose ES contexts",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/gles",
      "cacheVariables": {
        "SIMP_GLES": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer Debug (Clang)",
      "description": "Debug build of the project code with AddressSanitizer (Clang); vendored libraries stay uninstrumented",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SIMP_ASAN": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio)",
      "description": "Visual Studio 2022 solution; works from a plain terminal, no Ninja or developer prompt needed",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "gles", "configurePreset": "gles" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "windows", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } }
  ],
  "packagePresets": [
    { "name": "release", "configurePreset": "release", "packageDirectory": "${sourceDir}/build/package" },
    { "name": "windows", "configurePreset": "windows", "configurations": ["Release"], "packageDirectory": "${sourceDir}/build/package" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Configure, build and test (Debug)",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "package",
      "displayName": "Configure, build, test and package (Release)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" },
        { "type": "package", "name": "release" }
      ]
    },
    {
      "name": "windows",
      "displayName": "Configure, build, test and package (Windows, Visual Studio)",
      "steps": [
        { "type": "configure", "name": "windows" },
        { "type": "build", "name": "windows" },
        { "type": "test", "name": "windows" },
        { "type": "package", "name": "windows" }
      ]
    }
  ]
}
