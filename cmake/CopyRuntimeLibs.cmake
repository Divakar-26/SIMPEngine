if(NOT EXECUTABLE OR NOT DESTINATION)
    message(FATAL_ERROR "CopyRuntimeLibs needs EXECUTABLE and DESTINATION")
endif()

execute_process(COMMAND ldd "${EXECUTABLE}" OUTPUT_VARIABLE LDD_OUTPUT RESULT_VARIABLE LDD_RESULT ERROR_QUIET)
if(NOT LDD_RESULT EQUAL 0)
    message(WARNING "ldd failed for ${EXECUTABLE}; runtime libraries were not copied")
    return()
endif()

file(MAKE_DIRECTORY "${DESTINATION}")
string(REPLACE "\n" ";" LDD_LINES "${LDD_OUTPUT}")
foreach(line IN LISTS LDD_LINES)
    if(line MATCHES "^[ \t]*([^ \t]+) => (/[^ \t]+)")
        set(name "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        if(path MATCHES "^/(usr/)?lib(32|64|x32)?/")
            continue()
        endif()
        file(REAL_PATH "${path}" real)
        file(COPY_FILE "${real}" "${DESTINATION}/${name}" ONLY_IF_DIFFERENT)
    endif()
endforeach()
